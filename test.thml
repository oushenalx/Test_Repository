            noteType: 'warning'
        }, {
            name: '猫屋敷 政宗（新）',
            gender: '男',
            age: 42,
            flower: '三叶草',
            grade: 'A',
            location: '左臂肘关节、右臂肩膀',
            birth: '2008.05.07',
            infect: '2041.10.21',
            code: 'Trifolium.20411021.01',
            contact: '叶区【花店】公共电话',
            address: '叶区【花店】',
            growth: '基本覆盖双臂，已蔓延至颈部及脸部',
            str: 80,
            dex: 50,
            pow: 30,
            con: 65,
            app: 70,
            edu: 75,
            siz: 85,
            int: 70,
            luk: 55,
            note: '患者为自愿感染，请交接医师多注意其精神状态。花种品级转化案例；该花种后续往脑部生长概率为85%，请患者尽快进行[康复手术]。',
            noteType: 'danger'
        }, {
            name: '天国 五格',
            gender: '男',
            age: 37,
            flower: '三色堇',
            grade: 'B',
            location: '肺部',
            birth: '2013.04.03',
            infect: '2040.12.25',
            code: 'Viola tricolor L.20401225.01',
            contact: '叶区公立医院座机',
            address: '叶区公立医院三楼储物间',
            growth: '自左肺长出，目前布满胸口。',
            str: 70,
            dex: 60,
            pow: 0,
            con: 80,
            app: 65,
            edu: 70,
            siz: 75,
            int: 70,
            luk: 50,
            note: '无'
        }, {
            name: '竹下萤',
            gender: '女',
            age: 19,
            flower: '红蔷薇',
            grade: 'A',
            location: '左大腿',
            birth: '2031.01.22',
            infect: '2044.06.15',
            code: 'Rosa sp.20440615.02',
            contact: '花区A3号宅公共电话',
            address: '花区A3号宅',
            growth: '已布满左腿',
            str: 70,
            dex: 40,
            pow: 70,
            con: 70,
            app: 75,
            edu: 70,
            siz: 45,
            int: 50,
            luk: 70,
            note: '花种已轻微影响到患者的行走能力',
            noteType: 'warning'
        }];

        // ───────────────────────────────────────────────
        //  渲染
        // ───────────────────────────────────────────────

        const grid = document.getElementById('grid');

        function getGradeClass(grade) {
            const map = { 'A': 'grade-a', 'B': 'grade-b', 'C': 'grade-c', 'D': 'grade-d' };
            return map[grade] || '';
        }

        function statValue(v) {
            if (v === null || v === undefined) return '—';
            return v;
        }

        function statClass(v) {
            if (v === null || v === undefined) return '';
            // if (v >= 70) 
            return 'high';
            // if (v <= 30) return 'low';
            // return '';
        }

        function renderCard(p) {
            const div = document.createElement('div');
            div.className = 'card';

            // 品级
            const badge = document.createElement('span');
            badge.className = `card-badge ${getGradeClass(p.grade)}`;
            badge.textContent = `${p.grade}级 · ${p.flower}`;
            div.appendChild(badge);

            // 头部
            const head = document.createElement('div');
            head.className = 'card-head';
            head.innerHTML = `
                <span class="card-name">${p.name}</span>
                <span class="card-meta">
                    <span>${p.gender}</span>
                    <span class="sep">·</span>
                    <span>${p.age}岁</span>
                </span>
            `;
            div.appendChild(head);

            // 信息行
            const info = document.createElement('div');
            info.className = 'card-info';
            info.innerHTML = `
                <div><span class="label">寄生点</span><br><span class="value">${p.location}</span></div>
                <div><span class="label">出生日期</span><br><span class="value">${p.birth}</span></div>
                <div><span class="label">感染日期</span><br><span class="value">${p.infect}</span></div>
                <div><span class="label">编码</span><br><span class="value code">${p.code}</span></div>
                <div class="full"><span class="label">联系方式</span><br><span class="value">${p.contact}</span></div>
                <div class="full"><span class="label">住址</span><br><span class="value">${p.address}</span></div>
                <div class="full"><span class="label">生长状况</span><br><span class="value">${p.growth}</span></div>
            `;
            div.appendChild(info);

            // 属性
            const stats = document.createElement('div');
            stats.className = 'stats';
            const attrs = [
                ['STR', p.str],
                ['DEX', p.dex],
                ['POW', p.pow],
                ['CON', p.con],
                ['APP', p.app],
                ['EDU', p.edu],
                ['SIZ', p.siz],
                ['INT', p.int],
                ['LUK', p.luk]
            ];
            attrs.forEach(([label, val]) => {
                const item = document.createElement('div');
                item.className = 'stat-item';
                const v = statValue(val);
                const cls = statClass(val);
                item.innerHTML = `<span class="s-label">${label}</span><span class="s-value ${cls}">${v}</span>`;
                stats.appendChild(item);
            });
            div.appendChild(stats);

            // 备注
            if (p.note && p.note.trim() !== '' && p.note.trim() !== '无') {
                const notes = document.createElement('div');
                notes.className = `card-notes ${p.noteType || ''}`;
                notes.innerHTML = `<span class="note-label">⏺ 备注</span>${p.note}`;
                div.appendChild(notes);
            }

            return div;
        }

        function buildGrid() {
            grid.innerHTML = '';
            patients.forEach(p => {
                grid.appendChild(renderCard(p));
            });
        }

        // ───────────────────────────────────────────────
        //  交互
        // ───────────────────────────────────────────────

        const header = document.getElementById('header');
        const btnWrap = document.getElementById('btnWrap');
        const btnToggle = document.getElementById('btnToggle');
        const content = document.getElementById('content');
        const footer = document.getElementById('footer');
        const label = btnToggle.querySelector('.label');
        const icon = btnToggle.querySelector('.icon');

        let isOpen = false;

        function toggle() {
            isOpen = !isOpen;
            if (isOpen) {
                // 展开
                header.classList.add('shifted');
                btnWrap.classList.add('collapsed');
                content.classList.add('open');
                footer.classList.add('shifted');
                btnToggle.classList.add('open');
                label.textContent = '收起档案';
                icon.textContent = '▴';
            } else {
                // 收起
                header.classList.remove('shifted');
                btnWrap.classList.remove('collapsed');
                content.classList.remove('open');
                footer.classList.remove('shifted');
                btnToggle.classList.remove('open');
                label.textContent = '展开档案';
                icon.textContent = '▾';
            }
        }

        btnToggle.addEventListener('click', toggle);

        //————————————————————————————————————————————————
        //  搜索栏
        //—————————————————————————————————————————————————
        const searchInput = document.getElementById('searchInput');
        const searchBtn = document.getElementById('searchBtn');

        // ── Toast 提示工具 ──
        function showToast(message, type = 'info') {
            // 移除已有的 Toast（避免堆叠）
            const existing = document.querySelector('.toast-container');
            if (existing) existing.remove();

            // 创建容器和内容
            const container = document.createElement('div');
            container.className = 'toast-container';
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            toast.textContent = message;
            container.appendChild(toast);
            document.body.appendChild(container);

            // 触发淡入动画
            requestAnimationFrame(() => {
                container.classList.add('show');
            });

            // 3 秒后自动淡出并移除
            setTimeout(() => {
                container.classList.remove('show');
                setTimeout(() => container.remove(), 400);
            }, 3000);
        }

        function performSearch() {
            const query = searchInput.value.trim();
            if (!query) {
                // 如果搜索框为空，简单提醒或忽略
                return;
            }

            // 使用 requestAnimationFrame 等待 DOM 渲染完成后再滚动
            requestAnimationFrame(() => {
                const cards = document.querySelectorAll('.card');
                let found = false;

                cards.forEach((card, index) => {
                    const nameEl = card.querySelector('.card-name');
                    if (!nameEl) return;

                    const name = nameEl.textContent.trim();
                    // 忽略大小写，进行包含匹配
                    if (name.toLowerCase().includes(query.toLowerCase())) {
                        // 清除之前的高亮（如果有）
                        cards.forEach(c => {
                            c.style.transition = 'border 0.3s, box-shadow 0.3s';
                            c.style.border = '1px solid var(--border)';
                            c.style.boxShadow = 'none';
                        });

                        // 高亮当前卡片
                        card.style.border = '2px solid var(--accent)';
                        card.style.boxShadow = '0 0 30px rgba(79, 195, 247, 0.4)';

                        // 平滑滚动到卡片位置
                        card.scrollIntoView({ behavior: 'smooth', block: 'center' });

                        // 2.5 秒后自动移除高亮
                        setTimeout(() => {
                            card.style.border = '1px solid var(--border)';
                            card.style.boxShadow = 'none';
                        }, 2800);

                        found = true;
                        return; // 找到第一个匹配项后停止循环
                    }
                });

                if (!found) {
                    // 简单的轻提示，也可以改为在界面显示文字，这里使用 alert 做演示
                    // 你也可以替换为更优雅的 toast 提示
                    // alert(`未找到包含“${query}”的感染者档案。`);
                    showToast(`未找到包含“${query}”的感染者档案。`, 'warning');
                }
            });
        }

        // 点击按钮触发搜索
        searchBtn.addEventListener('click', performSearch);

        // 按键盘 Enter 键触发搜索
        searchInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault(); // 防止可能的表单提交
                performSearch();
            }
        });

        // ───────────────────────────────────────────────
        //  启动
        // ───────────────────────────────────────────────

        buildGrid();

    </script>

</body>

</html>
