<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>感染者档案 · 花区叶区医院联合</title>
    <style>
        /* ── 全局重置 & 变量 ── */
        :root {
            --bg: #ffffff;
            --surface: #cac6c6;
            --surface-light: #fefefe;
            --surface-bottom: #0a0a0a;
            --border: #2e2e38;
            --border-light: #3c3c48;

            --text-primary: #121212;
            --text-secondary: #9a9aa5;
            --text-tertiary: #6a6a78;
            --text-bottom: #ffc9c9;
            --text-label: #020202;

            --accent: #1b4e41;
            --accent-dim: #1a7a9a;
            --green: #66bb6a;
            --red: #ef5350;
            --orange: #ffa726;
            --yellow: #ffee58;
            --radius: 14px;
            --shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
            --transition: 0.45s cubic-bezier(0.25, 0.1, 0.25, 1);
            --font: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', 'Segoe UI', Roboto, sans-serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            -webkit-font-smoothing: antialiased;
        }

        body {
            font-family: var(--font);
            background: var(--bg);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding: 20px;
        }

        /* ── 主容器 ── */
        .app {
            width: 100%;
            max-width: 1280px;
            min-height: 92vh;
            display: flex;
            flex-direction: column;
            background: var(--surface);
            border-radius: var(--radius);
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
            overflow: hidden;
            position: relative;
            transition: min-height var(--transition);
        }

        /* ── 头部 ── */
        .header {
            padding: 48px 40px 32px;
            text-align: center;
            /* border-bottom: 1px solid var(--border); */
            background: linear-gradient(180deg, #7d7da0 0%, var(--surface) 100%);
            transition: padding var(--transition), transform var(--transition);
            flex-shrink: 0;
            position: relative;
            z-index: 2;
        }

        .header.shifted {
            padding: 18px 40px 14px;
            transform: translateY(0);
        }

        .header-title {
            font-size: clamp(2.2rem, 5vw, 3.6rem);
            font-weight: 700;
            letter-spacing: 0.06em;
            color: var(--text-primary);
            transition: font-size var(--transition);
        }

        .header-title .accent {
            color: var(--accent);
        }

        .header-sub {
            font-size: 1rem;
            font-weight: 400;
            letter-spacing: 0.12em;
            color: var(--text-tertiary);
            margin-top: 4px;
            text-transform: uppercase;
            transition: opacity var(--transition);
        }

        .header.shifted .header-sub {
            opacity: 0.6;
        }

        /* ── 按钮 ── */
        .btn-wrap {
            padding: 16px 40px 28px;
            text-align: center;
            flex-shrink: 0;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
            transition: padding var(--transition), border-color var(--transition);
        }

        .btn-wrap.collapsed {
            padding: 8px 40px 12px;
            border-bottom-color: transparent;
        }

        .btn-toggle {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            padding: 12px 36px;
            font-size: 0.95rem;
            font-weight: 600;
            letter-spacing: 0.06em;
            font-family: var(--font);
            background: var(--surface-bottom);
            color: var(--text-bottom);
            border: 1.5px solid var(--border-light);
            border-radius: 60px;
            cursor: pointer;
            transition: all var(--transition);
            outline: none;
        }

        .btn-toggle:hover {
            background: #2a2a34;
            border-color: var(--accent);
            box-shadow: 0 0 20px rgba(79, 195, 247, 0.08);
        }

        .btn-toggle .icon {
            display: inline-block;
            transition: transform var(--transition);
            font-size: 1.2rem;
            line-height: 1;
        }

        .btn-toggle.open .icon {
            transform: rotate(180deg);
        }

        /* ── 搜索框区域 ── */
        .search-area {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }

        .search-area input {
            flex: 1;
            min-width: 200px;
            max-width: 400px;
            padding: 10px 18px;
            font-size: 0.9rem;
            font-family: var(--font);
            background: var(--surface);
            border: 1.5px solid var(--border);
            border-radius: 60px;
            color: var(--text-primary);
            outline: none;
            transition: all var(--transition);
        }

        .search-area input::placeholder {
            color: var(--text-tertiary);
            letter-spacing: 0.04em;
        }

        .search-area input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 4px rgba(79, 244, 247, 0.15);
        }

        .search-area .btn-search {
            padding: 10px 28px;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.06em;
            font-family: var(--font);
            background: rgba(0, 0, 0, 0.619);
            color: var(--text-bottom);
            border: none;
            border-radius: 60px;
            cursor: pointer;
            transition: all var(--transition);
            white-space: nowrap;
        }

        .search-area .btn-search:hover {
            background: black;
            box-shadow: 0 0 24px rgba(79, 244, 247, 0.15);
        }

        /* —— 提示区域 ——*/
        .toast-container {
            position: fixed;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%) translateY(80px);
            z-index: 200;
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
            pointer-events: none;
        }

        .toast-container.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        .toast {
            padding: 14px 36px;
            border-radius: 12px;
            background: #3c3c48;
            border: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 0.9rem;
            font-weight: 500;
            box-shadow: 0 8px 40px rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(16px);
            letter-spacing: 0.03em;
            border-right: 4px solid rgba(79, 244, 247, 0.15);
            border-bottom: 4px solid rgba(79, 244, 247, 0.15);
            max-width: 90vw;
            text-align: center;
            white-space: nowrap;
        }

        /* 不同提示类型 */
        .toast.warning {
            color: var(--text-bottom);
        }

        /* ── 内容区（卡片流） ── */
        .content {
            flex: 1;
            padding: 0 40px 20px;
            overflow: hidden;
            max-height: 0;
            opacity: 0;
            transition: max-height 0.7s cubic-bezier(0.25, 0.1, 0.25, 1),
                opacity 0.5s ease 0.15s,
                padding 0.4s ease;
            background: var(--surface);
        }

        .content.open {
            max-height: 6000px;
            opacity: 1;
            padding: 28px 40px 32px;
        }

        /* ── 卡片网格 ── */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
            gap: 20px;
        }

        /* ── 单张卡片 ── */
        .card {
            background: var(--surface-light);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 20px 22px 18px;
            transition: all var(--transition);
            display: flex;
            flex-direction: column;
            gap: 12px;
            position: relative;
        }

        .card:hover {
            border-color: var(--border-light);
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
            transform: translateY(-2px);
        }

        /* 品级标签 */
        .card-badge {
            position: absolute;
            top: 14px;
            right: 16px;
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            padding: 3px 12px;
            border-radius: 20px;
            text-transform: uppercase;
            background: var(--border);
            color: var(--text-tertiary);
        }

        .card-badge.grade-a {
            background: rgba(239, 83, 80, 0.25);
            color: var(--red);
            border: 1px solid rgba(239, 83, 80, 0.3);
        }

        .card-badge.grade-b {
            background: rgba(255, 167, 38, 0.2);
            color: var(--orange);
            border: 1px solid rgba(255, 167, 38, 0.25);
        }

        .card-badge.grade-c {
            background: rgba(255, 238, 88, 0.15);
            color: #d4c84a;
            border: 1px solid rgba(255, 238, 88, 0.2);
        }

        .card-badge.grade-d {
            background: rgba(102, 187, 106, 0.18);
            color: var(--green);
            border: 1px solid rgba(102, 187, 106, 0.2);
        }

        /* 卡片头部 */
        .card-head {
            display: flex;
            align-items: baseline;
            gap: 12px;
            flex-wrap: wrap;
            padding-right: 70px;
        }

        .card-name {
            font-size: 1.25rem;
            font-weight: 700;
            letter-spacing: -0.01em;
            color: var(--text-primary);
        }

        .card-meta {
            font-size: 0.75rem;
            color: var(--text-tertiary);
            letter-spacing: 0.04em;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .card-meta span {
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .card-meta .sep {
            color: var(--border);
        }

        /* 卡片信息行 */
        .card-info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4px 16px;
            font-size: 0.82rem;
            color: var(--text-secondary);
            line-height: 1.6;
            padding: 8px 0 2px;
            border-top: 1px solid var(--border);
        }

        .card-info .label {
            color: var(--text-label);
            font-weight: 700;
            letter-spacing: 0.02em;
        }

        .card-info .value {
            color: var(--text-primary);
            font-weight: 400;
            word-break: break-word;
        }

        .card-info .full {
            grid-column: 1 / -1;
        }

        .card-info .code {
            font-family: 'SF Mono', 'Menlo', 'Monaco', monospace;
            font-size: 0.7rem;
            color: var(--text-tertiary);
            letter-spacing: 0.02em;
        }

        /* 属性区 */
        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 6px 12px;
            padding: 8px 0 2px;
            border-top: 1px solid var(--border);
        }

        .stat-item {
            display: flex;
            justify-content: space-between;
            font-size: 0.75rem;
            color: var(--text-secondary);
            align-items: baseline;
        }

        .stat-item .s-label {
            color: var(--text-tertiary);
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .stat-item .s-value {
            color: var(--text-primary);
            font-weight: 600;
            font-size: 0.85rem;
        }

        .stat-item .s-value.high {
            color: var(--accent);
        }

        .stat-item .s-value.low {
            color: var(--red);
        }

        /* 备注 */
        .card-notes {
            font-size: 0.78rem;
            color: var(--text-secondary);
            padding: 8px 12px;
            background: rgba(172, 170, 170, 0.25);
            border-radius: 8px;
            border-left: 5px solid var(--accent-dim);
            line-height: 1.5;
            margin-top: 2px;
        }

        .card-notes.warning {
            border-left-color: var(--orange);
            color: #463d2a;
        }

        .card-notes.danger {
            border-left-color: var(--red);
            color: #4a3232;
        }

        .card-notes .note-label {
            font-weight: 600;
            color: var(--text-tertiary);
            letter-spacing: 0.04em;
            font-size: 0.7rem;
            text-transform: uppercase;
            display: block;
            margin-bottom: 2px;
        }

        /* ── 脚注 ── */
        .footer {
            padding: 18px 40px 22px;
            text-align: center;
            /* border-top: 1px solid var(--border); */
            color: var(--text-tertiary);
            font-size: 0.78rem;
            letter-spacing: 0.04em;
            background: var(--surface);
            flex-shrink: 0;
            transition: padding var(--transition), transform var(--transition);
        }

        .footer.shifted {
            padding: 26px 40px 30px;
            transform: translateY(0);
        }

        .footer .dots {
            display: inline-flex;
            gap: 6px;
            margin: 0 12px;
        }

        .footer .dots span {
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: var(--border);
        }

        /* ── 空状态占位 ── */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: var(--text-tertiary);
            font-size: 0.9rem;
            letter-spacing: 0.04em;
        }

        .empty-state .big-icon {
            font-size: 2.8rem;
            margin-bottom: 16px;
            opacity: 0.4;
        }

        /* ── 响应式 ── */
        @media (max-width: 820px) {
            .grid {
                grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
                gap: 16px;
            }

            .header {
                padding: 32px 24px 24px;
            }

            .header.shifted {
                padding: 14px 24px 10px;
            }

            .btn-wrap {
                padding: 12px 24px 20px;
            }

            .btn-wrap.collapsed {
                padding: 6px 24px 10px;
            }

            .content.open {
                padding: 20px 24px 24px;
            }

            .footer {
                padding: 14px 24px 18px;
            }

            .footer.shifted {
                padding: 20px 24px 24px;
            }

            .card-info {
                grid-template-columns: 1fr;
                gap: 2px 0;
            }

            .stats {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 480px) {
            .grid {
                grid-template-columns: 1fr;
            }

            .header-title {
                font-size: 1.8rem;
            }

            .card-head {
                padding-right: 56px;
            }

            .card-badge {
                font-size: 0.55rem;
                padding: 2px 10px;
                top: 10px;
                right: 12px;
            }

            .stats {
                grid-template-columns: 1fr 1fr;
            }

            .btn-toggle {
                padding: 10px 24px;
                font-size: 0.85rem;
            }
        }

        /* ── 滚动条 ── */
        .content::-webkit-scrollbar {
            width: 5px;
        }

        .content::-webkit-scrollbar-track {
            background: var(--surface);
        }

        .content::-webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 4px;
        }

        .content::-webkit-scrollbar-thumb:hover {
            background: var(--border-light);
        }

        /* ── 动画 ── */
        @keyframes fadeSlide {
            0% {
                opacity: 0;
                transform: translateY(12px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .card {
            animation: fadeSlide 0.5s ease forwards;
        }

        .card:nth-child(1) {
            animation-delay: 0.02s;
        }

        .card:nth-child(2) {
            animation-delay: 0.05s;
        }

        .card:nth-child(3) {
            animation-delay: 0.08s;
        }

        .card:nth-child(4) {
            animation-delay: 0.11s;
        }

        .card:nth-child(5) {
            animation-delay: 0.14s;
        }

        .card:nth-child(6) {
            animation-delay: 0.17s;
        }

        .card:nth-child(7) {
            animation-delay: 0.20s;
        }

        .card:nth-child(8) {
            animation-delay: 0.23s;
        }

        .card:nth-child(9) {
            animation-delay: 0.26s;
        }

        .card:nth-child(10) {
            animation-delay: 0.29s;
        }

        .card:nth-child(11) {
            animation-delay: 0.32s;
        }

        .card:nth-child(12) {
            animation-delay: 0.35s;
        }
    </style>
</head>

<body>

    <div class="app" id="app">
        <!-- 头部 -->
        <header class="header" id="header">
            <div class="header-title">感染者档案</div>
            <div class="header-sub">花区私立医院 · 叶区公立医院</div>
        </header>

        <!-- 按钮 -->
        <div class="btn-wrap" id="btnWrap">
            <button class="btn-toggle" id="btnToggle">
                <span class="icon">▾</span>
                <span class="label">查看档案</span>
            </button>
        </div>

        <!-- 内容 -->
        <div class="content" id="content">
            <div class="search-area">
                <input type="text" id="searchInput" placeholder="输入姓名，按 Enter 或点击定位..." />
                <button class="btn-search" id="searchBtn">定位</button>
            </div>
            <div class="grid" id="grid"></div>
        </div>

        <!-- 脚注 -->
        <footer class="footer" id="footer">
            <span>© 2050 感染者社区</span>
            <span class="dots"><span></span><span></span><span></span></span>
            <span>内部使用 请勿外传</span>
        </footer>
    </div>

    <script>
        // ───────────────────────────────────────────────
        //  数据
        // ───────────────────────────────────────────────

        const patients = [{
            name: '北岛 晶',
            gender: '男',
            age: 25,
            flower: '虞美人',
            grade: 'D',
            location: '胸口',
            birth: '2025.11.13',
            infect: '2043.07.11',
            code: 'Papaver rhoeas L.20430711.08',
            contact: '地下黑街33号座机转接3号频道',
            address: '地下黑街33号',
            growth: '胸口至锁骨、双臂；中等范围生长',
            str: 55,
            dex: 65,
            pow: 60,
            con: 60,
            app: 70,
            edu: 50,
            siz: 65,
            int: 40,
            luk: 70,
            note: '无'
        }, {
            name: '宫原 小春',
            gender: '女',
            age: 25,
            flower: '昙花',
            grade: 'A',
            location: '腹部',
            birth: '2025.6.25',
            infect: '2045.05.20',
            code: 'Epiphyllum oxypetalum (DC.) Haw.20450520.11',
            contact: '花区私立医院A404病房座机',
            address: '花区私立医院A405病房',
            growth: '布满锁骨至腹部；大范围生长',
            str: 55,
            dex: 40,
            pow: 30,
            con: 70,
            app: 80,
            edu: 50,
            siz: 50,
            int: 45,
            luk: 80,
            note: '该患者会恶意引导花卉走势，请交接医师多注意其精神状态。',
            noteType: 'warning'
        }, {
            name: '荒川 英辉',
            gender: '男',
            age: 22,
            flower: '蓝星花',
            grade: 'A',
            location: '左手食指',
            birth: '2028.05.04',
            infect: '2050.04.03',
            code: 'Evolvulus nuttallianus Roem. et Schult.20500403.05',
            contact: '叶区公立医院306病房座机',
            address: '叶区公立医院306病房座机',
            growth: '布满左手，往手臂蔓延',
            str: 60,
            dex: 60,
            pow: 70,
            con: 65,
            app: 65,
            edu: 60,
            siz: 65,
            int: 60,
            luk: null,
            note: '患者为自愿感染，请交接医师多注意其精神状态。',
            noteType: 'warning'
        }, {
            name: '荒川 英奈',
            gender: '女',
            age: 22,
            flower: '蓝星花',
            grade: 'A',
            location: '左脸颊',
            birth: '2028.05.04',
            infect: '2050.01.03',
            code: 'Evolvulus nuttallianus Roem. et Schult.20500103.04',
            contact: 'A区私立医院A403病房座机',
            address: 'A区私立医院A403病房',
            growth: '布满左脸皮上，往颈部生长',
            str: 50,
            dex: 60,
            pow: 70,
            con: 55,
            app: 65,
            edu: 60,
            siz: 65,
            int: 60,
            luk: null,
            note: '患者寄生点接近脑部，需要定期前往所在地医院进行切除清理。患者临近产期（新备注）',
            noteType: 'danger'
        }, {
            name: '橘 太阳',
            gender: '男',
            age: 19,
            flower: '向日葵',
            grade: 'D',
            location: '颈部',
            birth: '2031.09.21',
            infect: '2046.07.06',
            code: 'Helianthus annuus L.20460706.16',
            contact: '叶区A15号宅公用电话',
            address: '叶区A15号宅',
            growth: '皮上部分稳定，正往皮下蔓延；花卉部分已涉及喉管',
            str: 60,
            dex: 70,
            pow: 70,
            con: 45,
            app: 50,
            edu: 40,
            siz: 55,
            int: 60,
            luk: 30,
            note: '由于该患者感染花种花型较大，导致体内堵塞或窒息概率较高；请定时前往所在地医院进行小范围切除处理。',
            noteType: 'danger'
        }, {
            name: '鹿鸣 剑',
            gender: '男',
            age: 18,
            flower: '巨花马兜铃',
            grade: 'A',
            location: '左肩',
            birth: '2032.06.28',
            infect: '2041.01.03',
            code: 'Aristolochia gigantea Mwrt. & Zucc.20411203.17',
